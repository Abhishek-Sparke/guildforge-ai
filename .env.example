# Demo works with all credentials blank. Copy to .env for local development.
APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
OPENAI_API_KEY=
# Set a model available to your project that supports Responses structured outputs.
OPENAI_MODEL=
# Neon PostgreSQL connection URL; the driver uses HTTPS, compatible with Sites Workers.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
MOCK_DISCORD=true
ENABLE_LIVE_DEPLOY=false
